# Magaldi Environment Configuration
# Copy this file to .env and customize as needed
# cp .env.example .env

# =============================================================================
# ELASTICSEARCH
# =============================================================================

# Port mapping (change if 9200 is in use)
ES_PORT=9200

# Heap size (adjust based on available memory)
# Minimum 512m, recommended 1g-2g for development
ES_HEAP_SIZE=1g

# =============================================================================
# REDIS
# =============================================================================

# Port mapping (change if 6379 is in use)
REDIS_PORT=6379

# =============================================================================
# KIBANA
# =============================================================================

# Port mapping (change if 5601 is in use)
KIBANA_PORT=5601

# =============================================================================
# OLLAMA
# =============================================================================

# Port mapping (change if 11434 is in use)
OLLAMA_PORT=11434

# -----------------------------------------------------------------------------
# Ollama Performance Tuning
# These must be set BEFORE starting Ollama. Add to ~/.zshrc or ~/.bashrc
# to persist, or to systemd service file if running as a service.
# -----------------------------------------------------------------------------

# Concurrent requests per model (increase for parallel workers)
# OLLAMA_NUM_PARALLEL=4

# Keep all 3 models loaded (summarization + embedding + features) to avoid swapping
# OLLAMA_MAX_LOADED_MODELS=3

# Keep models loaded indefinitely during long parsing runs (-1 = forever)
# OLLAMA_KEEP_ALIVE=-1

# Enable flash attention for faster inference and lower memory
# OLLAMA_FLASH_ATTENTION=1

# Max queued requests (increase for burst handling)
# OLLAMA_MAX_QUEUE=1024

# Number of GPU layers to offload (reduce if running out of VRAM)
# OLLAMA_NUM_GPU=999

# =============================================================================
# MAGALDI APPLICATION
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
MAGALDI_LOG_LEVEL=INFO

# Elasticsearch connection
MAGALDI_ELASTICSEARCH_HOST=localhost
MAGALDI_ELASTICSEARCH_PORT=9200
MAGALDI_ELASTICSEARCH_SCHEME=http

# Redis connection
MAGALDI_REDIS_HOST=localhost
MAGALDI_REDIS_PORT=6379
# MAGALDI_REDIS_PASSWORD=  # Uncomment if auth required

# Ollama connection (local or Docker)
MAGALDI_OLLAMA_URL=http://localhost:11434

# Web server
MAGALDI_WEB_HOST=0.0.0.0
MAGALDI_WEB_PORT=8080
