# Magaldi Environment Configuration
# Copy this file to .env and customize as needed
# cp .env.example .env

# =============================================================================
# ELASTICSEARCH
# =============================================================================

# Port mapping (change if 9200 is in use)
ES_PORT=9200

# Heap size (adjust based on available memory)
# Minimum 512m, recommended 1g-2g for development
ES_HEAP_SIZE=1g

# =============================================================================
# REDIS
# =============================================================================

# Port mapping (change if 6379 is in use)
REDIS_PORT=6379

# =============================================================================
# KIBANA
# =============================================================================

# Port mapping (change if 5601 is in use)
KIBANA_PORT=5601

# =============================================================================
# OLLAMA
# =============================================================================

# Port mapping (change if 11434 is in use)
OLLAMA_PORT=11434

# =============================================================================
# MAGALDI APPLICATION
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
MAGALDI_LOG_LEVEL=INFO

# Elasticsearch connection
MAGALDI_ELASTICSEARCH_HOST=localhost
MAGALDI_ELASTICSEARCH_PORT=9200
MAGALDI_ELASTICSEARCH_SCHEME=http

# Redis connection
MAGALDI_REDIS_HOST=localhost
MAGALDI_REDIS_PORT=6379
# MAGALDI_REDIS_PASSWORD=  # Uncomment if auth required

# Ollama connection (local or Docker)
MAGALDI_OLLAMA_URL=http://localhost:11434

# Web server
MAGALDI_WEB_HOST=0.0.0.0
MAGALDI_WEB_PORT=8080
